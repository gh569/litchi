# ===== 本地环境变量模板 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会上传到 git）
# 线上部署时，同名变量需在 Cloudflare Pages → Settings → Environment variables 中配置

# 大数据流式加载数据源
VITE_DATA_URL=
# 前端工具库
VITE_UTILS_URL=
# xlsx 解析库
VITE_XLSX_URL=
# 应用版本号
VITE_VERSION=

# Supabase（URL + public anon key，均为公开信息）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
